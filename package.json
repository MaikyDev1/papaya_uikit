{
  "name": "papaya",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:js && npm run copy:css",
    "copy:css": "copy /Y src\\theme.css dist\\theme.css",
    "build:js": "tsup",
    "build:css": "npx @tailwindcss/cli -i ./src/theme.css -o ./dist/theme.css --minify",
    "start": "next start"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "dependencies": {
    "@toolwind/corner-shape": "^0.0.8-3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
